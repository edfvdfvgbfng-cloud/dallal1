# ============================================================================
# دلال - منصة العقارات العراقية
# Environment Variables Configuration
# ============================================================================
# Copy this file to .env and fill in the actual values for production.
# DO NOT commit .env to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# Django Core Settings
# ----------------------------------------------------------------------------

# Debug mode (set to False in production)
DEBUG=False

# Secret key (generate a strong random key, minimum 50 characters)
# Use: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here-minimum-50-characters-long

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=daluailiraq.com,www.daluailiraq.com

# Custom domain
CUSTOM_DOMAIN=daluailiraq.com

# Railway public domain (auto-set by Railway)
RAILWAY_PUBLIC_DOMAIN=

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------

# PostgreSQL database URL (format: postgres://user:password@host:port/dbname)
DATABASE_URL=postgres://user:password@host:5432/dalal

# Optional: Redis URL for caching/sessions/WebSocket
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# Security Settings
# ----------------------------------------------------------------------------

# CSRF trusted origins (comma-separated HTTPS URLs)
CSRF_TRUSTED_ORIGINS=https://daluailiraq.com,https://www.daluailiraq.com

# Secure cookies (set to True in production with HTTPS)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ----------------------------------------------------------------------------
# Email Configuration
# ----------------------------------------------------------------------------

# Email backend (django.core.mail.backends.smtp.EmailBackend for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Default from email
DEFAULT_FROM_EMAIL=noreply@daluailiraq.com

# ----------------------------------------------------------------------------
# Social Authentication
# ----------------------------------------------------------------------------

# Google OAuth
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-client-id
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-client-secret

# Facebook OAuth
SOCIAL_AUTH_FACEBOOK_KEY=your-facebook-app-id
SOCIAL_AUTH_FACEBOOK_SECRET=your-facebook-app-secret

# ----------------------------------------------------------------------------
# File Storage & Media
# ----------------------------------------------------------------------------

# Cloudinary (optional, for cloud storage)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# AWS S3 (optional, alternative to Cloudinary)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# ----------------------------------------------------------------------------
# Geocoding & Maps
# ----------------------------------------------------------------------------

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Alternative: OpenStreetMap / Nominatim (free)
# Nominatim does not require an API key for low-volume usage

# Geocoding API (for address to coordinates conversion)
GEOCODING_API_KEY=your-geocoding-api-key

# ----------------------------------------------------------------------------
# AI & Machine Learning
# ----------------------------------------------------------------------------

# OpenAI API Key (for AI features)
OPENAI_API_KEY=your-openai-api-key

# Anthropic API Key (alternative AI provider)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Hugging Face API Key (for custom models)
HUGGINGFACE_API_KEY=your-huggingface-api-key

# AI Configuration
AI_ENABLED=False
AI_PROVIDER=openai
AI_MODEL=gpt-3.5-turbo
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
AI_RATE_LIMIT_ENABLED=True
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=20
AI_CONTENT_MODERATION_ENABLED=True
AI_LOGGING_ENABLED=False
AI_SAFE_MODE=True

# ----------------------------------------------------------------------------
# File Upload Security
# ----------------------------------------------------------------------------

UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_IMAGE_DIMENSIONS=4096
UPLOAD_SCAN_MALWARE=False
UPLOAD_USE_UUID_FILENAMES=True

# ----------------------------------------------------------------------------
# Payment Processing
# ----------------------------------------------------------------------------

# Stripe API Keys
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# PayPal API
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# ----------------------------------------------------------------------------
# SMS & Notifications
# ----------------------------------------------------------------------------

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Cloud Messaging (for push notifications)
FCM_SERVER_KEY=your-fcm-server-key

# OneSignal (alternative push notification service)
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# VAPID keys for Web Push
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ----------------------------------------------------------------------------
# Analytics & Monitoring
# ----------------------------------------------------------------------------

# Google Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXXX

# Sentry (error tracking)
SENTRY_DSN=your-sentry-dsn

# LogRocket (session replay)
LOGROCKET_APP_ID=your-logrocket-app-id

# ----------------------------------------------------------------------------
# Third-party Services
# ----------------------------------------------------------------------------

# reCAPTCHA (for spam protection)
RECAPTCHA_PUBLIC_KEY=your-recaptcha-public-key
RECAPTCHA_PRIVATE_KEY=your-recaptcha-private-key

# SendGrid (email delivery)
SENDGRID_API_KEY=your-sendgrid-api-key

# ----------------------------------------------------------------------------
# WebSocket Configuration
# ----------------------------------------------------------------------------

# Enable WebSocket (set to True if using Channels)
USE_WEBSOCKETS=True

# Redis for WebSocket channel layer (required for production)
CHANNEL_LAYERS_DEFAULT=channels_redis.core.RedisChannelLayer

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------

# Rate limit configuration (requests per minute)
RATE_LIMIT_API=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_UPLOAD=20

# ----------------------------------------------------------------------------
# Content Moderation
# ----------------------------------------------------------------------------

# Enable content moderation (AI-based)
ENABLE_CONTENT_MODERATION=True

# Content moderation API key
CONTENT_MODERATION_API_KEY=your-content-moderation-api-key

# ----------------------------------------------------------------------------
# Backup & Maintenance
# ----------------------------------------------------------------------------

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Automated backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# ----------------------------------------------------------------------------
# Locale & Language
# ----------------------------------------------------------------------------

# Default language code
LANGUAGE_CODE=ar

# Time zone
TIME_ZONE=Asia/Baghdad

# ----------------------------------------------------------------------------
# Development Settings (DO NOT USE IN PRODUCTION)
# ----------------------------------------------------------------------------

# Uncomment these ONLY for local development

# DEBUG=True
# SECRET_KEY=django-insecure-local-dev-only-change-me
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
